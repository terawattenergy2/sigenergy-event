# PostgreSQL connection (Neon / Supabase / managed Postgres; use pooled URL on Vercel)
DATABASE_URL=
# REQUIRED stable random secret, at least 32 characters. Do not rotate during the event.
APP_SECRET=
# One organizer account only. Generate hash with yarn admin:password.
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=
# Exact production origin; no trailing slash. Local development: http://127.0.0.1:3000
APP_URL=http://127.0.0.1:3000
# Public LINE add-friend URL. Replace with your own before opening registration.
NEXT_PUBLIC_LINE_OA_URL=
# Messaging API channel of the SAME LINE OA
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
# Company contact shown on registration privacy notice
NEXT_PUBLIC_COMPANY_NAME=TE
NEXT_PUBLIC_CONTACT_TEXT=กรุณาติดต่อผู้จัดงานเพื่อสอบถามหรือขอแก้ไขข้อมูล
